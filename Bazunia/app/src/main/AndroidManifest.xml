<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wymagane podstawowe uprawnienie do foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Wymagane dla API 31+ dla typu DATA_SYNC -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Wymagane dla API 33+ (Android 13) do wyświetlania powiadomień -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>


    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bazunia"
        tools:targetApi="31"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Serwis Socket.IO (obecnie nieaktywny, ale zdefiniowany z typem) -->
        <service
            android:name=".SensorMonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Serwis Klienta VPS (Polling/REST). Ustawiony typ na dataSync. -->
        <service android:name=".VpsClientService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" /> <!-- DODANO: dataSync, ponieważ serwis synchronizuje dane z VPS -->

        <activity android:name=".SettingsActivity" />
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" />
        <activity android:name=".DataActivity" />
        <activity android:name=".SensorDetailActivity"
            android:parentActivityName=".DataActivity" />

    </application>
</manifest>
