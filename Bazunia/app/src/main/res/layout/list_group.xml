<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/iconGroup"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_gateway"
        android:contentDescription="@string/gateway_icon_description" />

    <TextView
        android:id="@+id/textGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:text="@string/list_group_gateway_name_placeholder"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textGroupStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="@string/list_group_status_placeholder"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/iconExpansionIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:padding="8dp"
        android:contentDescription="@null"
        android:visibility="invisible" />

</LinearLayout>