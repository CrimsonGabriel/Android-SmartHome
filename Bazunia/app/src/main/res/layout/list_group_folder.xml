<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical">

    <View
        android:id="@+id/folderColorIndicator"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        android:background="#CCCCCC" />

    <ImageView
        android:id="@+id/iconFolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/desc_folder_icon"
        app:srcCompat="@drawable/ic_folder" />

    <TextView
        android:id="@+id/textFolderName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="@string/tools_folder_name"
        android:textAppearance="?attr/textAppearanceListItem"
        android:textSize="18sp" />

    <ImageView
        android:id="@+id/iconExpansionIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/desc_expand_icon"
        app:srcCompat="@drawable/ic_expand_arrow" />

</LinearLayout>