<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imgRiskIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_warning"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/risk_icon_desc" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRiskSensorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/preview_sensor_name"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/tvRiskIssue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/preview_risk_issue"
            android:textSize="14sp"
            android:textColor="#F44336" />
    </LinearLayout>
</LinearLayout>