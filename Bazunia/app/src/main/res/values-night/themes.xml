<resources>
    <style name="Base.Theme.Bazunia" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#93CCEA</item> <item name="colorOnPrimary">#00354A</item>
        <item name="colorPrimaryContainer">#004D6A</item>
        <item name="colorOnPrimaryContainer">#CDE5FF</item>

        <item name="android:colorBackground">#121212</item>
        <item name="colorOnBackground">#E2E2E5</item> <item name="colorSurface">#121212</item>
        <item name="colorOnSurface">#E2E2E5</item> <item name="colorSurfaceVariant">#41484D</item>
        <item name="colorOnSurfaceVariant">#C1C7CE</item>

        <item name="appButtonHeight">@dimen/button_height_medium</item>
