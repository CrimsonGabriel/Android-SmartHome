        <item name="appIconSize">@dimen/icon_size_medium</item>
        <item name="appCardCornerRadius">@dimen/corner_radius_medium</item>
    </style>

    <style name="Theme.Bazunia.ButtonSize.Large" parent="">
        <item name="appButtonHeight">@dimen/button_height_large</item>
        <item name="appIconSize">@dimen/icon_size_large</item>
        <item name="appCardCornerRadius">@dimen/corner_radius_large</item>
    </style>
